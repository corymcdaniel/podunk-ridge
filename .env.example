# The password for /admin. Set this in the Netlify dashboard (Site settings > Environment variables)
# and in a local .env file (which you should gitignore) for local dev with `netlify dev`.
ADMIN_PASSWORD=change-me

# Netlify Blobs auto-configures itself when deployed on Netlify or run via `netlify dev`.
# You do NOT need to set blob-related env vars yourself.
